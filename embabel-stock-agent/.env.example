# Provider switch: deeprelay (default) or azure
AI_PROVIDER=deeprelay

# DeepRelay (OpenAI-compatible)
DEEPRELAY_BASE_URL=https://api.deeprelay.ai/v1
DEEPRELAY_API_KEY=your-deeprelay-key
DEEPRELAY_MODEL=deeprelay/deepseek-v4.1-flash

# Azure / Microsoft Foundry (used when AI_PROVIDER=azure)
# The endpoint must be the OpenAI-compatible v1 endpoint, for example:
#   https://<resource-name>.openai.azure.com/openai/v1
#   https://<resource-name>.services.ai.azure.com/openai/v1
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_CHAT_DEPLOYMENT=gpt-4.1

# Finnhub free key (real-time quote, news, earnings calendar, dividends)
FINNHUB_API_KEY=your-finnhub-key

# Postgres / pgvector
POSTGRES_DB=stockagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=jdbc:postgresql://localhost:5432/stockagent

# Optional
SERVER_PORT=8092
UPLOAD_DIR=data/uploads
