{
  "expo": {
    "name": "Bank Agent",
    "slug": "bank-agent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bankagent",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-local-authentication",
      "expo-image-picker",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B5D3B",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.bankagent",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone is used for voice input to the banking assistant.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition turns your voice into chat messages.",
        "NSPhotoLibraryUsageDescription": "Attach photos or documents to your chat.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.example.bankagent",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {}
    }
  }
}
